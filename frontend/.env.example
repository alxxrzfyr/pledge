# Smart Contract Addresses (Deployed on Soroban Testnet)
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_TREASURY_CONTRACT_ID=

# Stellar / Soroban RPC Network Settings
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# IPFS Evidence Pinning (Pinata)
# Required for real on-chain evidence pinning. Get a JWT from
# https://app.pinata.cloud/developers/api-keys
# Without this set, the app runs in demo mode: evidence is hashed locally
# and NOT pinned to IPFS. The UI will show a visible "Demo Mode" warning.
PINATA_JWT=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud

